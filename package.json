{
  "name": "boutique-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor e-commerce marketplace (PERN + Next.js)",
  "workspaces": [
    "api",
    "store-frontend",
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:store": "npm run dev --workspace store-frontend",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "build:api": "npm run build --workspace api",
    "build:store": "npm run build --workspace store-frontend",
    "build:dashboard": "npm run build --workspace dashboard",
    "db:up": "docker compose up -d db adminer",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate --workspace api",
    "db:migrate": "npm run prisma:migrate --workspace api",
    "db:seed": "npm run seed --workspace api",
    "db:studio": "npm run prisma:studio --workspace api"
  },
  "engines": {
    "node": ">=20"
  }
}
