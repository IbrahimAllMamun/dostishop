generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  SUPER_ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  SSLCOMMERZ
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbandonedStatus {
  OPEN
  RECOVERED
  DISMISSED
}

/// How an attribute's values are rendered and edited. TEXT values are free
/// strings; COLOR values are drawn from the `Color` registry so the storefront
/// can paint a swatch instead of printing a word.
enum AttributeKind {
  TEXT
  COLOR
}

// ---------- Identity ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(VENDOR)
  status       UserStatus @default(ACTIVE)
  shop         Shop?      @relation("ShopOwner")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Shop {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  ownerId        String     @unique
  owner          User       @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  logoUrl        String?
  bannerUrl      String?
  description    String?
  phone          String?
  address        String?
  status         ShopStatus @default(PENDING)
  commissionRate Decimal    @default(10.0) @db.Decimal(5, 2) // percent taken by platform
  products       Product[]
  subOrders      SubOrder[]
  payouts        Payout[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ---------- Catalog ----------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  // Lucide icon name (e.g. "ShoppingBag") shown when there is no imageUrl
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  sortOrder Int        @default(0)
  // Vendor who created it (null = seeded or admin-created). A vendor may edit or
  // delete only their own categories.
  createdById String?
  // Set the moment a SUPER_ADMIN edits the category. Once the platform has
  // curated it, the original vendor loses edit rights for good.
  adminLocked Boolean  @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdById])
}

model Product {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  name        String
  slug        String           @unique
  description String?
  brand       String?
  basePrice   Decimal          @db.Decimal(10, 2)
  salePrice   Decimal?         @db.Decimal(10, 2)
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  ratingAvg   Decimal          @default(0) @db.Decimal(3, 2)
  ratingCount Int              @default(0)
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  /// The attributes this product uses — variant axes and spec attributes alike
  attributes  ProductAttribute[]
  /// Values for the spec attributes above
  specValues  ProductAttributeValue[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([shopId])
  @@index([categoryId])
}

model Review {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  phone        String
  rating       Int // 1..5
  comment      String?
  orderNo      String?
  isVerified   Boolean       @default(false) // order contained this product
  status       ReviewStatus  @default(PENDING)
  photos       ReviewPhoto[]
  createdAt    DateTime      @default(now())

  @@index([productId, status])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String?     @unique
  // Denormalised copies of the Size/Color attribute values. Kept in sync on
  // write because checkout labels, CSV import/export and the storefront facets
  // still read them; `attributes` below is the normalised source of truth.
  size          String?
  color         String?
  priceOverride Decimal?    @db.Decimal(10, 2)
  stockQty      Int         @default(0)
  orderItems    OrderItem[]
  attributes    VariantAttribute[]

  @@index([productId])
}

// ---------- Attributes ----------
// A registry of the dimensions a product varies along (Size, Color, Material…)
// or is described by (Fabric, Warranty). Vendors may add their own; ownership
// works exactly like Category — the creator may edit until an admin curates it.

/// The shared colour palette. Kept as its own table rather than a hex column on
/// AttributeValue so a colour is defined once and reused: two shops naming the
/// same maroon get the same swatch, and correcting a hex fixes every product.
model Color {
  id          String           @id @default(cuid())
  name        String           @unique
  /// `#RRGGBB`, lowercase. Validated at the API boundary.
  hexCode     String
  sortOrder   Int              @default(0)
  createdById String?
  adminLocked Boolean          @default(false)
  values      AttributeValue[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
}

model Attribute {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  kind        AttributeKind      @default(TEXT)
  /// True: an axis variants differ along (Size, Colour) — it multiplies stock
  /// rows. False: a product-level specification (Fabric, Warranty) that is
  /// stated once per product and never creates a variant.
  isVariant   Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdById String?
  adminLocked Boolean            @default(false)
  values      AttributeValue[]
  products    ProductAttribute[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([createdById])
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  /// For COLOR attributes this mirrors `color.name`, kept in sync on write:
  /// checkout labels, CSV export and the storefront facets all read strings.
  value       String
  /// Set only on values of a COLOR attribute.
  colorId     String?
  color       Color?                  @relation(fields: [colorId], references: [id], onDelete: SetNull)
  sortOrder   Int                     @default(0)
  variants    VariantAttribute[]
  productSpecs ProductAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@index([colorId])
}

/// Join table: a variant is defined by the set of values it carries.
model VariantAttribute {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  valueId   String
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
  @@index([valueId])
}

/// Which attributes a product actually uses. Without this the product form has
/// to show every attribute in the registry on every product, and an axis the
/// vendor has chosen but not yet filled in has nowhere to live.
model ProductAttribute {
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@id([productId, attributeId])
  @@index([attributeId])
}

/// The chosen values for a product's non-variant (spec) attributes. Many rows
/// per attribute are allowed — "Features: Waterproof, Lightweight" is one
/// attribute with two values.
model ProductAttributeValue {
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  valueId   String
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, valueId])
  @@index([valueId])
}

// ---------- Orders ----------
// One customer checkout = one Order, split into one SubOrder per shop.

model Order {
  id             String        @id @default(cuid())
  orderNo        String        @unique
  // Guards against double-submitted checkouts
  idempotencyKey String?       @unique
  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  zone          String // inside_dhaka | outside_dhaka
  note          String?
  paymentMethod PaymentMethod @default(COD)
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingTotal Decimal       @db.Decimal(10, 2)
  discountTotal Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  subOrders     SubOrder[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([phone])
}

model SubOrder {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId           String
  shop             Shop          @relation(fields: [shopId], references: [id])
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  subtotal         Decimal       @db.Decimal(10, 2)
  shippingCost     Decimal       @default(0) @db.Decimal(10, 2)
  commissionRate   Decimal       @db.Decimal(5, 2)
  commissionAmount Decimal       @db.Decimal(10, 2)
  vendorPayout     Decimal       @db.Decimal(10, 2)
  trackingNo       String?
  // Set once this sub-order is included in a vendor payout
  payoutId         String?
  payout           Payout?       @relation(fields: [payoutId], references: [id])
  items            OrderItem[]
  events           SubOrderEvent[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([shopId])
  @@index([orderId])
  @@index([payoutId])
}

/// Append-only history of a sub-order's status. `SubOrder.status` is the
/// current value; this is how it got there, and it is what the tracking
/// timeline renders. Never updated or deleted — only inserted.
model SubOrderEvent {
  id         String      @id @default(cuid())
  subOrderId String
  subOrder   SubOrder    @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  /// Free-text detail shown to the customer, e.g. "Handed to courier"
  note       String?
  /// Who recorded it; null for system-generated events such as checkout
  createdById String?
  createdAt  DateTime    @default(now())

  @@index([subOrderId, createdAt])
}

model OrderItem {
  id           String          @id @default(cuid())
  subOrderId   String
  subOrder     SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productId    String
  productName  String // snapshot at purchase time
  variantLabel String? // snapshot e.g. "M / Black"
  unitPrice    Decimal         @db.Decimal(10, 2) // snapshot
  quantity     Int
  lineTotal    Decimal         @db.Decimal(10, 2)

  @@index([subOrderId])
}

// ---------- Marketing & ops ----------

model Coupon {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType @default(PERCENTAGE)
  value      Decimal      @db.Decimal(10, 2)
  minOrder   Decimal      @default(0) @db.Decimal(10, 2)
  usageLimit Int?
  usageCount Int          @default(0)
  expiresAt  DateTime?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  title     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Payout {
  id         String       @id @default(cuid())
  shopId     String
  shop       Shop         @relation(fields: [shopId], references: [id])
  periodFrom DateTime
  periodTo   DateTime
  gross      Decimal      @db.Decimal(10, 2)
  commission Decimal      @db.Decimal(10, 2)
  net        Decimal      @db.Decimal(10, 2)
  status     PayoutStatus @default(PENDING)
  subOrders  SubOrder[]
  createdAt  DateTime     @default(now())

  @@index([shopId])
}

// Checkout started but never submitted — captured for call-back recovery
model AbandonedCheckout {
  id           String          @id @default(cuid())
  customerName String?
  phone        String
  items        Json // [{ name, qty, price }]
  subtotal     Decimal         @db.Decimal(10, 2)
  status       AbandonedStatus @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([phone, status])
}

model SearchQuery {
  id        String   @id @default(cuid())
  term      String
  results   Int
  createdAt DateTime @default(now())

  @@index([term])
}

model Setting {
  id                   String   @id @default(cuid())
  storeName            String   @default("Marketplace")
  shippingInsideDhaka  Decimal  @default(60) @db.Decimal(10, 2)
  shippingOutsideDhaka Decimal  @default(120) @db.Decimal(10, 2)
  supportPhone         String?
  supportEmail         String?
  updatedAt            DateTime @updatedAt
}
