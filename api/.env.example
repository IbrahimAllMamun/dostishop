DATABASE_URL="postgresql://marketplace:marketplace@localhost:15432/marketplace?schema=public"
NODE_ENV=development
PORT=4000
JWT_SECRET=super_secret_dev_key_change_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5174
COOKIE_SECURE=false

# Public base URL of this API (used to build URLs for locally-stored uploads)
API_PUBLIC_URL=http://localhost:4000

# Public storefront URL (used in the Facebook catalog feed links)
STORE_PUBLIC_URL=http://localhost:3000

# Optional: set these to store uploads on Cloudinary instead of local disk
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=your_key
# CLOUDINARY_API_SECRET=your_secret
