{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(npm view *)",
      "Bash(npx tsc*)",
      "Bash(npx prisma*)",
      "Bash(npx shadcn*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose logs*)",
      "Bash(docker inspect*)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Read(./api/.env)",
      "Read(./store-frontend/.env.local)",
      "Read(./dashboard/.env.local)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --accept-data-loss*)"
    ]
  },
  "enabledMcpjsonServers": ["shadcn"]
}
