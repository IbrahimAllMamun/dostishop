{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--workspace",
        "store-frontend",
        "--",
        "next",
        "dev",
        "-p",
        "3400"
      ],
      "port": 3400
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:dashboard"
      ],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    }
  ]
}
